<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lambda.framework</groupId>
        <artifactId>lambda-framework-example-service-a</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lambda-framework-example-service-a-server</artifactId>
    <properties>
        <lambda.docker.directory>${project.basedir}/../lambda-framework-example-service-a-docker</lambda.docker.directory>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-example-service-a-enum</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-example-service-a-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-rsocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-compliance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-guid</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-qdrant</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-httpclient</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${lambda.docker.directory}</directory>
                            <includes>
                                <include>app.jar</include>
                            </includes>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>macos-arm</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                    <version>${netty.version}</version>
                    <classifier>osx-aarch_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-intel</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                    <version>${netty.version}</version>
                    <classifier>osx-x86_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
