<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.lambda.framework</groupId>
        <artifactId>lambda-example-service-a</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lambda-example-service-a-app</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-example-service-a-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-rsocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-compliance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-guid</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-qdrant</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>macos-arm</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                    <version>${netty.version}</version>
                    <classifier>osx-aarch_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>macos-intel</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.netty</groupId>
                    <artifactId>netty-resolver-dns-native-macos</artifactId>
                    <version>${netty.version}</version>
                    <classifier>osx-x86_64</classifier>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
