<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>ace-microservices-service-server</artifactId>
    <name>ace-microservices-service-server</name>
    <description>ace-microservices-service-server</description>
    <parent>
        <groupId>ace.microservices.service</groupId>
        <artifactId>ace-microservices-service</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <!--<relativePath/>--> <!-- lookup parent from repository -->
    </parent>
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>ace.microservices.service</groupId>
            <artifactId>ace-microservices-service-facade</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-rpc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-nacos</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-rsocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-repository</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-loadbalance</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-lock</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lambda.framework</groupId>
            <artifactId>lambda-framework-mq</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>ace.microservices.service.server.Run</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- 设置跳过测试 -->
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
