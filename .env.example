# Copy to .env, then use the addresses and credentials of your deployment.
JAVA_HOME='/path/to/jdk-27/Contents/Home'
SERVICE_HOST='127.0.0.1'
SERVICE_USER='root'
SERVICE_PASSWORD='replace-me'

# Single-node mode. Run MongoDB as a one-member replica set with the database in the URI.
NACOS_SERVER_ADDR='127.0.0.1:8848'
NACOS_NAMESPACE='public'
NACOS_GROUP='LAMBDA_EXAMPLE'
# NACOS_USERNAME='nacos'
# NACOS_PASSWORD='replace-me'
MONGODB_URI='mongodb://root:replace-me@127.0.0.1:27017/lambda_example?authSource=admin&replicaSet=rs0'
MONGODB_MODE='single'
REDIS_NODES='127.0.0.1:6379'
REDIS_MODE='single'
# REDIS_USERNAME='root'
# REDIS_PASSWORD='replace-me'
QDRANT_ENDPOINTS='grpc://127.0.0.1:6334'
QDRANT_MODE='single'
# QDRANT_API_KEY='replace-me'
EXAMPLE_VECTOR_REPLICATION_FACTOR='1'
RABBITMQ_ADDRESSES='127.0.0.1:5672'
RABBITMQ_MODE='single'
# RABBITMQ_USERNAME='root'
# RABBITMQ_PASSWORD='replace-me'

# Optional components. Set the endpoint to activate and check it at startup.
# LAMBDA_MQ_KAFKA_BOOTSTRAPSERVERS='127.0.0.1:9092'
# LAMBDA_MQ_KAFKA_MODE='single'
# LAMBDA_LOCK_ZOOKEEPER_CONNECTSTRING='127.0.0.1:2181'
# LAMBDA_LOCK_ZOOKEEPER_MODE='single'
LAMBDA_GUID_MODE='single'

# Cluster overrides. Enable a component's block after replacing every host and credential.
# NACOS_SERVER_ADDR='nacos-1.internal:8848,nacos-2.internal:8848,nacos-3.internal:8848'
# MONGODB_URI='mongodb://root:replace-me@mongo-1.internal:27017,mongo-2.internal:27017,mongo-3.internal:27017/lambda_example?authSource=admin&replicaSet=rs0'
# MONGODB_MODE='cluster'
# REDIS_NODES='redis-1.internal:6379,redis-2.internal:6379,redis-3.internal:6379'
# REDIS_MODE='cluster'
# QDRANT_ENDPOINTS='grpc://qdrant-1.internal:6334,grpc://qdrant-2.internal:6334,grpc://qdrant-3.internal:6334'
# QDRANT_MODE='cluster'
# EXAMPLE_VECTOR_REPLICATION_FACTOR='3'
# RABBITMQ_ADDRESSES='rabbit-1.internal:5672,rabbit-2.internal:5672,rabbit-3.internal:5672'
# RABBITMQ_MODE='cluster'
# LAMBDA_MQ_KAFKA_BOOTSTRAPSERVERS='kafka-1.internal:9092,kafka-2.internal:9092,kafka-3.internal:9092'
# LAMBDA_MQ_KAFKA_MODE='cluster'
# LAMBDA_LOCK_ZOOKEEPER_CONNECTSTRING='zk-1.internal:2181,zk-2.internal:2181,zk-3.internal:2181'
# LAMBDA_LOCK_ZOOKEEPER_MODE='cluster'
# LAMBDA_GUID_MODE='cluster'
# LAMBDA_INSTANCE_INDEX='0'

EXAMPLE_DEMO_USER='demo'
EXAMPLE_DEMO_PASSWORD='replace-with-a-demo-password'
EXAMPLE_RESOURCE_PREFIX='lambda_example'
APP_BIND_ADDRESS='127.0.0.1'
APP_REGISTER_IP='127.0.0.1'
APP_RSOCKET_PORT='7000'
APP_PORT='8081'
GATEWAY_BIND_ADDRESS='127.0.0.1'
SERVICE_B_BIND_ADDRESS='127.0.0.1'
SERVICE_B_REGISTER_IP='127.0.0.1'
SERVICE_B_RSOCKET_PORT='7001'
