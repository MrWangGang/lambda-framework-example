# Copy to .env, fill in your values; .env is ignored by Git.
JAVA_HOME='/path/to/jdk-27/Contents/Home'
SERVICE_HOST='127.0.0.1'
SERVICE_USER='root'
SERVICE_PASSWORD='replace-me'
NACOS_NAMESPACE='public'
NACOS_GROUP='LAMBDA_EXAMPLE'
MONGODB_REPLICA_SET='rs0'
MONGO_DATABASE='lambda_example'
EXAMPLE_RESOURCE_PREFIX='lambda_example'
APP_NAME='lambda-example-app'
APP_BIND_ADDRESS='127.0.0.1'
APP_REGISTER_IP='127.0.0.1'
APP_PORT='8081'
APP_RSOCKET_PORT='7000'
GATEWAY_NAME='lambda-example-gateway'
GATEWAY_BIND_ADDRESS='127.0.0.1'
